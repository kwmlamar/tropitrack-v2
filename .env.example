# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI — the single AI provider for this app.
#
# 2026-09-06: the assistant moved off Anthropic onto OpenAI, so one key now
# powers everything: the assistant (/assistant, /api/ai/chat), receipt OCR and
# vision parsing, estimate generation, ⌘K smart search and the description
# generator. There is no ANTHROPIC_API_KEY any more.
#
# Check it with GET /api/ai/health, which reports the provider, the model,
# whether the key is present, and WHY a call failed. Note that OpenAI returns
# 429 for both a rate limit and an exhausted quota — the health check tells
# them apart, because "out of credit" is the failure that killed this feature
# for six days in August.
OPENAI_API_KEY=your_openai_api_key

# Assistant and estimate generation. Optional; defaults to gpt-4o.
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MAX_TOKENS=2048

# The cheap, high-volume path: receipt vision parsing, ⌘K search, description
# generation. Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Email Configuration (Optional - for sending invitations)
RESEND_API_KEY=your_resend_api_key

# App URL (Optional - defaults to Vercel URL in production)
# Used for OAuth redirects; must match Supabase "Redirect URLs"
NEXT_PUBLIC_APP_URL=http://localhost:3000
