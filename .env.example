# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic — powers the in-app assistant (/assistant, /api/ai/chat).
#
# This key was missing from this file entirely, which is part of why the
# assistant dying on 2026-08-31 went unnoticed for six days: nothing in the
# repo said it existed. Check it with GET /api/ai/health, which reports the
# provider, the model, whether the key is present, and why a call failed.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional. Defaults to claude-sonnet-4-6. Echoed by the health check.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048

# OpenAI — receipt OCR (src/lib/ocr) and the ⌘K smart search / description
# generator. Separate from the assistant above, which is Anthropic.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Email Configuration (Optional - for sending invitations)
RESEND_API_KEY=your_resend_api_key

# App URL (Optional - defaults to Vercel URL in production)
# Used for OAuth redirects; must match Supabase "Redirect URLs"
NEXT_PUBLIC_APP_URL=http://localhost:3000
